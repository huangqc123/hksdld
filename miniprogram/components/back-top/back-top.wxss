.back-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 200;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(12, 20, 38, 0.94);
  border: 1rpx solid rgba(200, 170, 110, 0.5);
  color: #c8aa6e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  opacity: 0;
  transform: translateY(16rpx);
  pointer-events: none;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.back-top.on {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.press {
  opacity: 0.75;
}
