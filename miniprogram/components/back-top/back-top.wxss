.back-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1a2744;
  border: 2rpx solid #c8aa6e;
  color: #c8aa6e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.45);
}
.press {
  opacity: 0.75;
}
