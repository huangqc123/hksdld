.page {
  padding: 24rpx 24rpx 60rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: #1e2d4b;
  border: 1rpx solid rgba(200, 170, 110, 0.3);
  margin-right: 22rpx;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0e6d2;
}

.title {
  margin-top: 6rpx;
  color: #8b9bb4;
  font-size: 24rpx;
}

.meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  color: #c5d0e0;
  font-size: 22rpx;
}

.tier {
  font-weight: 700;
}

.note {
  padding: 18rpx 20rpx;
  margin-bottom: 22rpx;
  color: #b7c2d4;
  font-size: 24rpx;
  line-height: 1.55;
}

.note strong {
  color: #c8aa6e;
  font-weight: 700;
}

.note-sub {
  display: block;
  margin-top: 8rpx;
  color: #7f8ea3;
  font-size: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0e6d2;
}

.section-title.mt {
  margin-top: 36rpx;
}

.section-desc {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  color: #8b9bb4;
  font-size: 22rpx;
}

.combos {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.combo {
  padding: 22rpx;
}

.combo-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.combo-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.combo-rank {
  color: #c8aa6e;
  font-weight: 800;
  font-size: 30rpx;
}

.combo-title {
  color: #f5f0e6;
  font-size: 30rpx;
  font-weight: 700;
}

.combo-metrics {
  display: flex;
  gap: 16rpx;
}

.metric {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.metric-val {
  color: #f0e6d2;
  font-size: 26rpx;
  font-weight: 700;
}

.metric-label {
  color: #7f8ea3;
  font-size: 18rpx;
  margin-top: 2rpx;
}

.combo-tip {
  margin-top: 10rpx;
  color: #8b9bb4;
  font-size: 22rpx;
}

.combo-cards {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.c-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 6rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
}

.c-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.2);
}

.c-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #e8eef7;
  text-align: center;
  line-height: 1.25;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.c-rarity {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.c-perf {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #c8aa6e;
  font-weight: 700;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.ftab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #9aa4b2;
  background: rgba(255, 255, 255, 0.04);
  font-size: 24rpx;
}

.ftab.active {
  color: #0a1428;
  background: linear-gradient(90deg, #c8aa6e, #f0e6d2);
  font-weight: 700;
}

.sort-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sort-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8b9bb4;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sort-chip.on {
  color: #c8aa6e;
  border-color: rgba(200, 170, 110, 0.45);
}

.aug-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.aug-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
}

.aug-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(200, 170, 110, 0.25);
  flex-shrink: 0;
}

.aug-body {
  flex: 1;
  min-width: 0;
}

.aug-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.aug-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f5f0e6;
}

.rarity {
  font-size: 22rpx;
  font-weight: 700;
}

.tag-match {
  font-size: 20rpx;
  color: #0a1428;
  background: #c8aa6e;
  border-radius: 8rpx;
  padding: 0 10rpx;
  font-weight: 700;
}

.aug-stats {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
  color: #c5d0e0;
  font-size: 22rpx;
}

.stat-strong {
  color: #c8aa6e;
  font-weight: 700;
}

.aug-desc {
  margin-top: 8rpx;
  color: #9aa8bc;
  font-size: 22rpx;
  line-height: 1.45;
}

.retry-btn {
  margin-top: 24rpx;
  background: #c8aa6e !important;
  color: #0a1428 !important;
}

.footer-note {
  margin-top: 40rpx;
  text-align: center;
  color: #5d6b80;
  font-size: 20rpx;
  line-height: 1.6;
}

.empty-wrap.sm {
  padding: 40rpx 20rpx;
}
