.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 20rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #f0e6d2;
}
.header-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b9bb4;
}
.stats {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.stat .n {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fbbf24;
}
.stat .n.c2 { color: #38bdf8; }
.stat .n.c3 { color: #4ade80; }
.stat .n.c4 { color: #f87171; }
.stat .l {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7f8ea3;
}

.search {
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}
.search-input {
  height: 72rpx;
  color: #e8eef8;
  font-size: 26rpx;
}
.ph { color: #64748b; }

/* 主 Tab */
.tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8b9bb4;
  font-weight: 600;
}
.tab.on {
  color: #c8aa6e;
  border-bottom: 4rpx solid #c8aa6e;
}

/* 横向滚动：固定高度 + 内部 inline-block，避免被拉高 */
.h-scroll {
  width: 100%;
  height: 72rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}
.h-scroll-inner {
  display: inline-block;
  height: 72rpx;
  white-space: nowrap;
  padding-right: 8rpx;
}
.chip {
  display: inline-block;
  vertical-align: middle;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}
.chip.on {
  color: #0a1428;
  background: linear-gradient(90deg, #c8aa6e, #e8d5a3);
  border-color: transparent;
  font-weight: 700;
}

.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.tchip {
  padding: 8rpx 18rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #7f8ea3;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.tchip.on {
  color: #c8aa6e;
  border-color: rgba(200, 170, 110, 0.45);
}
.tlink {
  margin-left: auto;
  font-size: 22rpx;
  color: #c8aa6e;
  padding: 8rpx 0;
}
.count {
  margin-left: auto;
  font-size: 22rpx;
  color: #64748b;
}

.tip {
  font-size: 22rpx;
  color: #7f8ea3;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* 英雄宫格：4 列更稳 */
.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.g-item {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
  position: relative;
}
.g-icon {
  display: block;
  width: 100%;
  height: 148rpx;
  border-radius: 14rpx;
  background: #12203a;
  border: 1rpx solid rgba(200, 170, 110, 0.2);
}
.g-grade {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  z-index: 1;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.55);
}
.g-name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e8eef8;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.g-wr {
  display: block;
  font-size: 20rpx;
  color: #c8aa6e;
  text-align: center;
  font-weight: 700;
}

/* 列表 */
.list, .alist, .ilist, .load-list {
  display: flex;
  flex-direction: column;
}
.l-item, .a-item, .i-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx;
  margin-bottom: 12rpx;
}
.l-rank {
  width: 40rpx;
  font-size: 22rpx;
  color: #64748b;
  padding-top: 30rpx;
  text-align: center;
  flex-shrink: 0;
}
.l-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  margin: 0 14rpx;
  background: #12203a;
  flex-shrink: 0;
}
.l-main, .a-main, .i-main {
  flex: 1;
  min-width: 0;
}
.l-row, .a-row, .i-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.l-name, .a-name, .i-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f0e6d2;
  margin-right: 10rpx;
}
.l-sub, .l-meta, .a-meta, .i-desc, .a-desc, .load-d {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b9bb4;
  line-height: 1.4;
}
.a-icon, .i-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  margin-right: 14rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(200, 170, 110, 0.25);
  flex-shrink: 0;
}
.a-r, .i-cat {
  font-size: 20rpx;
  margin-right: 10rpx;
}
.i-cat {
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.12);
  padding: 0 10rpx;
  border-radius: 8rpx;
}
.i-g {
  margin-left: auto;
  color: #fbbf24;
  font-size: 22rpx;
  font-weight: 700;
}
.a-tags {
  margin-top: 8rpx;
}
.tag {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
}
.a-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.a-perf {
  color: #f87171;
  font-weight: 700;
  margin-right: 16rpx;
}

.load {
  padding: 18rpx;
  margin-bottom: 14rpx;
}
.load-h {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}
.load-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0e6d2;
}
.load-n {
  font-size: 20rpx;
  color: #c8aa6e;
}
.load .h-scroll,
.load .h-scroll-inner {
  height: 148rpx;
}
.la {
  display: inline-block;
  vertical-align: top;
  width: 120rpx;
  margin-right: 12rpx;
  text-align: center;
}
.la-i {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.2);
}
.la-n {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #cbd5e1;
  white-space: normal;
  line-height: 1.25;
  height: 48rpx;
  overflow: hidden;
}

.foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 20rpx;
  color: #475569;
}

.loading-wrap,
.empty-wrap {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #7f8ea3;
}
